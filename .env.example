# URL base de tu proyecto en https://mockapi.io (sin barra final)
# Ejemplo: https://6650a1b2c3d4e5f6a7b8c9d0.mockapi.io/api/v1
VITE_MOCKAPI_URL=

# Nombre del recurso creado en MockAPI (por defecto "recuerdos")
VITE_MOCKAPI_RESOURCE=recuerdos

# ID de cliente OAuth de Google para "Importar de Google Fotos" (opcional)
# Ejemplo: 1234567890-abc123.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Notificaciones push del chat (llegan aunque la página esté cerrada)
# Genera el par con: npx web-push generate-vapid-keys
# La pública va dos veces: VITE_ (para la página) y sin prefijo (para la función de Netlify).
# La privada SOLO en Netlify (Environment variables), nunca en el código.
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
